# Copy this file to .env and fill in your own Supabase project's values
# (Project Settings -> API in the Supabase dashboard). The anon key is
# safe to ship in client-side code — it only has the permissions you
# grant it via Row Level Security policies (see supabase/schema.sql).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
